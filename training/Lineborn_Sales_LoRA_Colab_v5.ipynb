{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Lineborn Sales LoRA v5\n",
        "Fresh end-to-end Google Colab trainer for Qwen3-4B-Instruct-2507. This version fixes the Transformers 5 `warmup_ratio` API break, adds config compatibility handling for both SFT and DPO, streams real errors, and refuses to export unless both real adapters exist. Use a GPU runtime and Run all."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os, shutil, subprocess, sys\n",
        "from pathlib import Path\n",
        "\n",
        "def run(*args):\n",
        "    cmd = list(map(str, args))\n",
        "    print('>', ' '.join(cmd), flush=True)\n",
        "    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)\n",
        "    tail = []\n",
        "    assert proc.stdout is not None\n",
        "    for line in proc.stdout:\n",
        "        print(line, end='', flush=True)\n",
        "        tail.append(line)\n",
        "        if len(tail) > 220:\n",
        "            tail.pop(0)\n",
        "    code = proc.wait()\n",
        "    if code:\n",
        "        raise RuntimeError(f'Command failed with exit code {code}: {cmd}\\n\\nLAST OUTPUT:\\n' + ''.join(tail))\n",
        "    return code\n",
        "\n",
        "run('nvidia-smi')\n",
        "print('Notebook Python:', sys.version)\n",
        "print('Executable:', sys.executable)\n",
        "root = Path('/content/lineborn-runtime')\n",
        "if root.exists():\n",
        "    shutil.rmtree(root)\n",
        "run('git', 'clone', '--depth', '1', '--branch', 'lineborn-sales-lora', 'https://github.com/SumamaAhmed69/Axemetric-Caller-Beta-Runtime.git', str(root))\n",
        "os.chdir(root)\n",
        "run('git', 'rev-parse', 'HEAD')\n",
        "run(sys.executable, '-m', 'pip', 'install', '--upgrade', '-q', 'jedi>=0.19.2')\n",
        "run(sys.executable, '-m', 'pip', 'install', '--upgrade', '-q', '-r', 'training/requirements-colab.txt')\n",
        "run(sys.executable, '-c', \"import sys,torch,transformers,peft,trl,datasets,accelerate,bitsandbytes; assert torch.cuda.is_available(), 'CUDA GPU not available'; print('python',sys.version); print('torch',torch.__version__,'cuda',torch.version.cuda,'gpu',torch.cuda.get_device_name(0)); print('transformers',transformers.__version__); print('peft',peft.__version__); print('trl',trl.__version__); print('datasets',datasets.__version__); print('accelerate',accelerate.__version__); print('bitsandbytes',bitsandbytes.__version__)\")\n",
        "print('Environment ready:', root)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Cheap preflight before downloading/loading the 4B model.\n",
        "run(sys.executable, '-m', 'py_compile', 'training/train_sales_lora.py', 'training/train_sales_dpo.py', 'training/package_sales_adapters.py')\n",
        "run(sys.executable, '-c', \"import inspect; from transformers import TrainingArguments; from trl import DPOConfig,DPOTrainer; print('TrainingArguments warmup_steps', 'warmup_steps' in inspect.signature(TrainingArguments.__init__).parameters); print('DPOConfig warmup_steps', 'warmup_steps' in inspect.signature(DPOConfig.__init__).parameters); print('DPOTrainer processing_class', 'processing_class' in inspect.signature(DPOTrainer.__init__).parameters)\")\n",
        "sft_source = Path('training/train_sales_lora.py').read_text('utf-8')\n",
        "dpo_source = Path('training/train_sales_dpo.py').read_text('utf-8')\n",
        "assert 'warmup_ratio=' not in sft_source and '\\"warmup_ratio\\"' not in sft_source, 'stale SFT warmup_ratio API still present'\n",
        "assert 'warmup_ratio=' not in dpo_source and '\\"warmup_ratio\\"' not in dpo_source, 'stale DPO warmup_ratio API still present'\n",
        "print('Training API preflight passed')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Build and safety-check the sales corpus.\n",
        "run(sys.executable, 'training/build_sales_corpus.py')\n",
        "run(sys.executable, 'training/validate_sales_corpus.py')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Stage 1: QLoRA supervised fine-tuning.\n",
        "run(sys.executable, 'training/train_sales_lora.py', '--max-length', '1536', '--epochs', '2', '--grad-accum', '16')\n",
        "sft_model = Path('training/output/lineborn-sales-sft/adapter/adapter_model.safetensors')\n",
        "assert sft_model.is_file(), 'SFT adapter_model.safetensors missing'\n",
        "assert sft_model.stat().st_size > 1024 * 1024, f'SFT adapter suspiciously small: {sft_model.stat().st_size} bytes'\n",
        "print(f'SFT adapter ready: {sft_model.stat().st_size / 1024 / 1024:.1f} MiB')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Stage 2: preference optimization.\n",
        "run(sys.executable, 'training/train_sales_dpo.py', '--max-length', '1536', '--epochs', '1', '--grad-accum', '16')\n",
        "dpo_model = Path('training/output/lineborn-sales-dpo/adapter/adapter_model.safetensors')\n",
        "assert dpo_model.is_file(), 'DPO adapter_model.safetensors missing'\n",
        "assert dpo_model.stat().st_size > 1024 * 1024, f'DPO adapter suspiciously small: {dpo_model.stat().st_size} bytes'\n",
        "print(f'DPO adapter ready: {dpo_model.stat().st_size / 1024 / 1024:.1f} MiB')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Verify, hash, package and download only a complete candidate.\n",
        "archive = Path('/content/lineborn-sales-adapters-v5.zip')\n",
        "if archive.exists():\n",
        "    archive.unlink()\n",
        "run(sys.executable, 'training/package_sales_adapters.py', '--require-dpo', '--archive', str(archive))\n",
        "assert archive.is_file(), 'candidate archive missing'\n",
        "assert archive.stat().st_size > 2 * 1024 * 1024, f'candidate archive suspiciously small: {archive.stat().st_size} bytes'\n",
        "print(f'Candidate archive ready: {archive.stat().st_size / 1024 / 1024:.1f} MiB')\n",
        "from google.colab import files\n",
        "files.download(str(archive))"
      ]
    }
  ],
